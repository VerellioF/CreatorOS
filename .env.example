# ==============================================================================
# CREATOROS AI — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local and populate the secrets.
# DO NOT COMMIT .env.local TO GIT.
# ==============================================================================

# --- Application Configuration ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Supabase Configuration ---
# Found in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsIn..."
# Strictly server-side only. NEVER expose to NEXT_PUBLIC_*
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsIn..."

# --- Cryptographic Security ---
# 32-character hexadecimal key for encrypting OAuth tokens at rest
ENCRYPTION_SECRET="generate-32-byte-hex-key-here-for-aes-256"

# --- AI Providers (Server-side Only) ---
# Primary Text & Image: Google Gemini API (Google AI Studio)
GEMINI_API_KEY=""

# Fallback Text & Audio: OpenAI API
OPENAI_API_KEY=""

# Primary Voiceover Synthesis: ElevenLabs API
ELEVENLABS_API_KEY=""

# Primary Video Generation: RunwayML API
RUNWAY_API_SECRET=""

# --- Background Processing (Inngest) ---
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# --- Payment Gateway: Midtrans (Indonesia) ---
MIDTRANS_SERVER_KEY=""
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION="false"

# --- Error Monitoring (Sentry) ---
NEXT_PUBLIC_SENTRY_DSN=""
